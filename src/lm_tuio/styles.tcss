/* =========================================
   GLOBAL LAYOUT / CLASSES
   ========================================= */
Screen {
    layout: vertical;
    outline: double $primary;
    padding: 0 1 1 1;
}

Button {
    border: none;
    width: 16;
    height: 1;
}

/* =========================================
   CLASSES
   ========================================= */
.box {
    border-top: round $secondary 60%;
    border-right: round $secondary 60%;
    content-align: center middle;
    height: 100%;
    border-title-align: left;
    border-title-color: $primary;
    border-title-background: rgba(0, 0, 0, 0);
    border-title-style: italic;

    &:focus-within {
        border-top: round $accent;
        border-right: round $accent;
        border-title-align: left;
        border-title-color: $accent;
        border-title-background: rgba(0, 0, 0, 0);
    }
}

.section-title {
    text-style: bold;
    color: $accent;
    margin-top: 1;
}

.hidden {
    display: none;
}

.ctx-titles {
    text-style: bold;
    color: $accent;
    margin-top: 1;
}

.ctx-horizontal-group {
    height: auto;
}

/* =========================================
   HEADER ZONE
   ========================================= */
#header-zone {
    height: 7;
    margin: 1 1 1 1;
}

#conn-status {
    text-style: bold;
    border: none;
    padding: 1;
    content-align: left middle;
    width: 20%;
    min-width: 30;
    max-width: 40;
    margin-right: 2;
}

#logo-title {
    border: round $secondary 2%;
    /* background: rgba(0, 0, 0, 0.1); */
    border-subtitle-align: right;
    border-subtitle-color: $primary;
    border-subtitle-background: rgba(0, 0, 0, 0);
    border-subtitle-style: italic;
    width: 25%;
    min-width: 38;
    margin-right: 4;
    content-align: left top;
    text-align: left;
    color: $primary;
}

#action-log {
    width: 1fr;
    border-right: none;
    margin: 1 2 0 3;
    background: transparent;
}

/* =========================================
   MAIN APP ZONE
   ========================================= */
#main-zone {
    height: 1fr;
    margin: 1 1 1 1;
}

#loaded-models,
#downloaded-models {
    width: 1fr;
}

/* =========================================
   LOADED MODELS HEADER & MEMORY BAR
   ========================================= */
#loaded-models-total-mem-header {
    width: 100%;
    height: 1;
    margin-bottom: 1;
    background: rgba(0, 0, 0, 0.25);
    color: $accent;
    content-align: right middle;
    text-align: right;
}

#loaded-models-total-mem {
    color: $accent;
    text-align: right;
    text-style: bold;
}

#loaded-models-scroll {
    width: 100%;
    height: 1fr;
    padding: 0;
}

#context-pane {
    width: 1fr;
    padding: 1 2;
}

#ctx-details-pane {
    height: 100%;
}

.ctx-horizontal-group,
.ctx-horizontal-group>Vertical,
.ctx-horizontal-group>Vertical>Label {
    height: auto;
}

#ctx-separator {
    border-top: ascii $secondary;
    border-title-align: center;
    border-title-style: italic;
    border-title-color: $accent;
    height: 1;
    margin: 1 0 0 0;
}

#ctx-placeholder {
    text-style: bold italic;
    color: $primary;
}

/* DataTable List Styling */
DataTable {
    background: transparent;
    border: none;
    width: 100%;
    height: 100%;
}

DataTable>.datatable--header {
    background: $surface;
    color: $primary;
    text-style: bold;
}

DataTable>.datatable--cursor {
    background: transparent;
    color: $text;
}

DataTable:focus>.datatable--cursor {
    background: $secondary;
    color: $background;
    text-style: bold;
}

/* SelectionList (Loaded Models collapsible) */
SelectionList>.option-list--option-highlighted {
    background: transparent;
    color: $text;
}

SelectionList:focus>.option-list--option-highlighted {
    background: $secondary;
    color: $background;
    text-style: bold;
}

Horizontal>Label {
    height: auto;
}

Horizontal>DataTable {
    height: 4;
}

/* =========================================
   LOADED MODELS PANE
   ========================================= */
#loaded-models-scroll {
    height: 100%;
    width: 100%;
    padding: 0;
}

Collapsible {
    padding: 0;
    margin-bottom: 1;
    background: transparent;
    border: none;
}

Collapsible>.collapsible--title {
    background: $surface;
    color: $accent;
    text-style: bold;
    padding: 0 1;
}

SelectionList {
    background: transparent;
    border: none;
    height: auto;
    max-height: 10;
    padding-left: 2;
    /* Indents instances under the Base Model title */
}

SelectionList:focus {
    border: none;
}

/* =========================================
   FOOTER / SEARCH BAR
   ========================================= */

#filter-label-zone {
    height: 1;
    content-align: left bottom;
    margin: 0 0 1 2;
}

#filter-label {
    color: $accent;
    text-style: bold;
}

#search-bar {
    dock: bottom;
    width: 100%;
    border: round $primary;
    background: $surface;
    color: $text;
}

/* =========================================
   MODAL - SERVER SELECTION
   ========================================= */
ServerSelectionModal {
    align: center middle;
    background: rgba(0, 0, 0, 0.5);
    padding: 0;
}

#modal-container {
    width: 45%;
    height: 75%;
    background: $surface;
    border: thick $primary;
    padding: 0 1 0 1;
}

#sidebar {
    width: 45%;
    height: 100%;
    border-right: solid $primary-background;
    padding: 0 1 1 1;
}

#active-server-sidebar,
#cached-ips-sidebar {
    height: 1fr;
}

#active-servers-list,
#cached-ips-list {
    height: 1fr;
    border: none;
    padding: 1;
    background: rgba(0, 0, 0, 0.30);
}

#active-servers-list:focus,
#cached-ips-list:focus {
    outline: round $secondary;
    padding: 1 1 0 1;
}

#main-action-area {
    width: 55%;
    padding: 2 1 -1 3;
}

#server-section,
#scan-section {
    height: 1fr;
}

.server-select-input-field {
    width: auto;
    min-width: 32;
    margin: 0 0 1 0;
    /* background: rgba(0, 0, 0, 0.25); */
    border: round $secondary 80%;
    border-subtitle-align: right;
    border-subtitle-color: $accent-darken-2;
    border-subtitle-background: rgba(0, 0, 0, 0);
    border-subtitle-style: italic;
}

#connect-btn,
#default-connect-btn,
#scan-btn,
#default-network-btn {
    margin: 0 1 1 0;
}

#cancel-btn,
#bottom-btn-group {
    align: center middle;
    margin: 1 2 1 0;
}

.button-group {
    height: 3;
    margin-top: 2;
}
