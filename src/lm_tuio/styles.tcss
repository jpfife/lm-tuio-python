/* ========= ID Selectors (id='widget_instance') ========= */
#header-zone {
    height: 5;
    margin-bottom: 1;
}

#logo-title {
    border: none;
    width: 2fr;
}

#main-zone {
    height: 1fr;
}

#loaded-models {
    width: 25%;
}

#downloaded-models {
    width: 30%;
}

#context-pane {
    width: 45%;
}


