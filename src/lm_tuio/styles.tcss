/* =========================================
   GLOBAL LAYOUT / CLASSES
   ========================================= */
Screen {
    layout: vertical;
    outline: double $primary;
    padding: 0 1 1 1;
}

Button {
    border: none;
    width: 16;
    height: 1;
}

/* =========================================
   UTILITY CLASSES
   ========================================= */
.box {
    border-top: round $secondary 60%;
    border-right: round $secondary 60%;
    content-align: center middle;
    height: 100%;
    border-title-align: left;
}

.section-title {
    text-style: bold;
    color: $accent;
    margin-top: 1;
}

.hidden {
    display: none;
}

/* =========================================
   HEADER ZONE
   ========================================= */
#header-zone {
    height: 7;
    margin: 1 1 1 1;
}

#logo-title {
    border: round $secondary 2%;
    background: rgba(0, 0, 0, 0.1);
    border-subtitle-align: right;
    border-subtitle-color: $primary;
    border-subtitle-background: rgba(0, 0, 0, 0);
    border-subtitle-style: italic;
    width: 1fr;
    min-width: 38;
    margin-right: 2;
    content-align: center top;
    text-align: center;
    color: $primary;
}

#conn-status {
    text-style: bold;
    border: none;
    padding: 1;
    content-align: left middle;
    width: 1fr;
    min-width: 35;
    margin-right: 2;
}

#action-log {
    width: 2fr;
    border-title-align: left;
    border-title-color: $primary;
    border-title-background: rgba(0, 0, 0, 0);
    border-title-style: italic;
}

/* =========================================
   MAIN APP ZONE
   ========================================= */
#main-zone {
    height: 1fr;
    margin: 1 1 1 1;
}

#loaded-models,
#downloaded-models {
    width: 1fr;
    border-title-align: left;
    border-title-color: $primary;
    border-title-background: rgba(0, 0, 0, 0);
    border-title-style: italic;
}

#context-pane {
    width: 2fr;
    border-title-align: left;
    border-title-color: $primary;
    border-title-background: rgba(0, 0, 0, 0);
    border-title-style: italic;
    padding: 1 2;
}

/* DataTable List Styling */
DataTable {
    background: transparent;
    border: none;
    width: 100%;
    height: 100%;
}

DataTable>.datatable--header {
    background: $surface;
    color: $primary;
    text-style: bold;
}

DataTable>.datatable--cursor {
    background: $secondary;
    color: $background;
}

/* =========================================
   FOOTER / SEARCH BAR
   ========================================= */
#vim-search-bar {
    dock: bottom;
    width: 100%;
    border: none;
    background: $surface;
    color: $text;
}

/* =========================================
   MODAL - SERVER SELECTION
   ========================================= */
ServerSelectionModal {
    align: center middle;
    background: rgba(0, 0, 0, 0.5);
    padding: 0;
}

#modal-container {
    width: 45%;
    height: 75%;
    background: $surface;
    border: thick $primary;
    padding: 0 1 0 1;
}

#sidebar {
    width: 45%;
    height: 100%;
    border-right: solid $primary-background;
    padding: 0 1 1 1;
}

#active-server-sidebar,
#cached-ips-sidebar {
    height: 1fr;
}

#active-servers-list,
#cached-ips-list {
    height: 1fr;
    border: none;
    padding: 1;
    background: rgba(0, 0, 0, 0.25);
}

#main-action-area {
    width: 55%;
    padding: 2 1 -1 3;
}

#server-section,
#scan-section {
    height: 1fr;
}

.server-select-input-field {
    width: auto;
    min-width: 32;
    margin: 0 0 1 0;
    background: rgba(0, 0, 0, 0.25);
    border: round $secondary 2%;
    border-subtitle-align: right;
    border-subtitle-color: $secondary;
    border-subtitle-background: rgba(0, 0, 0, 0);
    border-subtitle-style: italic;
}

#connect-btn,
#default-connect-btn,
#scan-btn,
#default-network-btn {
    margin: 0 1 1 0;
}

#cancel-btn,
#bottom-btn-group {
    align: center middle;
    margin: 1 2 1 0;
}

.button-group {
    height: 3;
    margin-top: 2;
}
